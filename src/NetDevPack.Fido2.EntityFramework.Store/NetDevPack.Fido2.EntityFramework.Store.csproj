<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>NetDevPack.Fido2.EntityFramework.Store</PackageId>
    <Authors>Bruno Brito</Authors>
    <Company>NetDevPack</Company>
    <PackageTags>Fido2 WebAuthn Passkeys EntityFramework EF</PackageTags>
    <Title>Fido2 EntityFramework Store</Title>
    <Description>Entity Framework Core store for the Fido2 (WebAuthn / passkeys) library, integrated with ASP.NET Core Identity.</Description>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>IconNuget.png</PackageIcon>
    <PackageReadmeFile>README.MD</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/NetDevPack/Fido2.EntityFramework.Store</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NetDevPack/Fido2.EntityFramework.Store</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fido2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\IconNuget.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.MD" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NetDevPack.Fido2.EntityFramework.Store.Tests" />
  </ItemGroup>

  <Target Name="CopyHook" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Debug' And '$(CI)' != 'true'">
    <ItemGroup>
      <_CustomFiles Include="$(MSBuildThisFileDirectory)../../.github/hooks/commit-msg" />
    </ItemGroup>
    <Copy SourceFiles="@(_CustomFiles)" DestinationFolder="$(MSBuildThisFileDirectory)../../.git/hooks" Condition="Exists('$(MSBuildThisFileDirectory)../../.git')" />
  </Target>
</Project>
